# PostgreSQL connection (reuses barekat docker-compose db; separate database)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/master_catalog

# Rate limiting (requests per second)
RATE_LIMIT_RPS=1.0
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5

# SnappMarket scraping (undocumented internal endpoints — update if they change)
SNAPP_BASE_URL=https://api.snapp.market
SNAPP_VENDOR_CODE=0
# Comma-separated category IDs to crawl (examples; replace with live IDs)
SNAPP_CATEGORY_IDS=1,2,3
SNAPP_PAGE_SIZE=24
SNAPP_COOKIE=
